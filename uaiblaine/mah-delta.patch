+# A copy of the MAH reusable workflow (moodle-an-hochschulen/moodle-workflows,
+# .github/workflows/moodle-plugin-ci.yml at 756e15d), with three additions (UAIBLAINE.md):
+# a dependency listed in plugin-dependencies that is not publicly readable is cloned with
+# the PLUGIN_DEPENDENCIES_TOKEN secret (MAH clones every dependency anonymously and has no
+# input to authenticate it, so a plugin depending on a private repository cannot use it);
+# the Development Leftover Checker skips the code declared in thirdpartylibs.xml; and
+# gherkinlint skips the features of the plugin dependencies.
+#
+# Everything else stays MAH's on purpose, so `mdl ci <repo> --matrix` keeps deriving the
+# same legs and gates from a caller's ci.yml: the file name (mdl-ci selects jobs whose
+# `uses` matches moodle-plugin-ci.yml), every input name and default, the matrix (read
+# from MAH's matrix.json at run time, the same file `mdl ci --refresh-matrix` vendors)
+# and MAH's composite actions (still referenced from MAH).
+#
+# The delta is the `secrets:` entry below, the two "Add plugin dependencies" steps, the
+# Development Leftover Checker step and the Grunt step, kept as uaiblaine/mah-delta.patch.
+# To follow MAH: fetch its file again, apply the patch, re-run actionlint, and update the
+# commit named above.
 name: Moodle Plugin CI
 
 on:
@@ -149,6 +167,9 @@ on:
       GENERIC_PASSWORD_2:
         description: Generic secret to pass another password to the workflow, if needed
         required: false
+      PLUGIN_DEPENDENCIES_TOKEN:
+        description: Read-only token (fine-grained, Contents read) for the plugin dependencies which are not publicly readable; only used to clone those, never exported to the test steps
+        required: false
 
 permissions:
   contents: read
@@ -511,15 +532,40 @@ jobs:
           sudo locale-gen en_AU.UTF-8
           echo "NVM_DIR=$HOME/.nvm" >> $GITHUB_ENV
 
+      # A dependency that answers an anonymous `git ls-remote` is cloned exactly as MAH
+      # clones it. Any other one is cloned with PLUGIN_DEPENDENCIES_TOKEN, which reaches
+      # git only through GIT_CONFIG_* variables of that single add-plugin call (a
+      # url.insteadOf rewrite of that one repository's URL): it is never written to disk,
+      # never stored as the clone's origin URL, and invisible to the plugin code that the
+      # later steps run. Secrets are withheld from pull requests opened from forks and by
+      # Dependabot, so such runs stop here with the error below rather than at a git 128.
       - name: Add plugin dependencies
         if: ${{ inputs.plugin-dependencies != '' }}
+        env:
+          PLUGIN_DEPENDENCIES: ${{ inputs.plugin-dependencies }}
+          DEPENDENCIES_TOKEN: ${{ secrets.PLUGIN_DEPENDENCIES_TOKEN }}
         run: |
+          if [ -n "$DEPENDENCIES_TOKEN" ]; then
+            echo "::add-mask::$DEPENDENCIES_TOKEN"
+          fi
           # Process plugin dependencies line by line, skipping empty lines
-          echo "${{ inputs.plugin-dependencies }}" | while IFS=',' read -r repo branch; do
+          printf '%s\n' "$PLUGIN_DEPENDENCIES" | while IFS=',' read -r repo branch; do
             # Skip empty lines
             if [ -n "$repo" ] && [ -n "$branch" ]; then
               echo "Adding plugin dependency: $repo (branch: $branch)"
-              moodle-plugin-ci add-plugin --branch "$branch" "$repo"
+              if GIT_TERMINAL_PROMPT=0 git ls-remote "https://github.com/$repo.git" HEAD > /dev/null 2>&1; then
+                moodle-plugin-ci add-plugin --branch "$branch" "$repo"
+              elif [ -n "$DEPENDENCIES_TOKEN" ]; then
+                echo "$repo is not publicly readable, cloning it with the PLUGIN_DEPENDENCIES_TOKEN secret."
+                GIT_TERMINAL_PROMPT=0 \
+                  GIT_CONFIG_COUNT=1 \
+                  GIT_CONFIG_KEY_0="url.https://x-access-token:${DEPENDENCIES_TOKEN}@github.com/${repo}.insteadOf" \
+                  GIT_CONFIG_VALUE_0="https://github.com/${repo}" \
+                  moodle-plugin-ci add-plugin --branch "$branch" "$repo"
+              else
+                echo "::error::The plugin dependency $repo is not publicly readable and no PLUGIN_DEPENDENCIES_TOKEN secret reached this workflow. Map it in the secrets block of the calling ci.yml job; pull requests from forks and from Dependabot never receive secrets."
+                exit 1
+              fi
             fi
           done
 
@@ -572,11 +618,43 @@ jobs:
           # Define patterns to search for
           PATTERNS=("@testme" "TODO" "<<<<<<< HEAD")
 
+          # Third-party code declared in thirdpartylibs.xml is not ours to clean (uaiblaine delta): skip each
+          # declared location and, for an AMD source, the build files generated from it.
+          SKIP=()
+          if [ -f ./plugin/thirdpartylibs.xml ]; then
+            while IFS= read -r loc; do
+              loc="${loc%/}"
+              [ -n "$loc" ] || continue
+              SKIP+=("./plugin/$loc")
+              case "$loc" in
+                amd/src/*.js)
+                  b="${loc#amd/src/}"
+                  b="${b%.js}"
+                  SKIP+=("./plugin/amd/build/$b.min.js" "./plugin/amd/build/$b.min.js.map")
+                  ;;
+              esac
+            done < <(grep -oE '<location>[^<]+</location>' ./plugin/thirdpartylibs.xml | sed -E 's#</?location>##g')
+          fi
+          is_skipped() {
+            local s
+            for s in "${SKIP[@]}"; do
+              if [[ "$1" == "$s" || "$1" == "$s"/* ]]; then
+                return 0
+              fi
+            done
+            return 1
+          }
+          FILES=()
+          while IFS= read -r f; do
+            is_skipped "$f" || FILES+=("$f")
+          done < <(find ./plugin -type f -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/vendor/*' | sort)
+          echo "Skipping ${#SKIP[@]} third-party path(s) declared in thirdpartylibs.xml."
+
           # Check each pattern
           FOUND_ISSUES=false
           for pattern in "${PATTERNS[@]}"; do
             echo "Searching for: $pattern"
-            if grep -rn --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=vendor "$pattern" ./plugin/; then
+            if [ "${#FILES[@]}" -gt 0 ] && grep -nH -- "$pattern" "${FILES[@]}"; then
               FOUND_ISSUES=true
               echo ""
             fi
@@ -655,9 +733,57 @@ jobs:
             done
           fi
 
+      # uaiblaine delta: moodle-plugin-ci runs core's gherkinlint task from the Moodle root, which lints
+      # every feature in the tree, so two plugin dependencies sharing a feature name (mod_customcert and
+      # tool_certificate share seven) fail the plugin under test on files it does not own. Core's task
+      # reads a .gherkin-lintignore at the Moodle root: it is written here with the directory each
+      # dependency was installed in, so the plugin's own features stay linted against core's, with
+      # core's rules, and the dependencies' are not linted at all. node_modules/** is gherkin-lint's
+      # default, which any ignore file replaces. The function is bin/lib/mah-parity.sh's in
+      # uaiblaine/moodle-dev, copied verbatim, where `mdl selfcheck mahparity` tests it.
       - name: Grunt
         if: ${{ !cancelled() }}
-        run: moodle-plugin-ci grunt --max-lint-warnings ${{ inputs.grunt-max-lint-warnings }}
+        run: |
+          mah_gherkin_lintignore() {
+              local moodle="$1" extras="$2" dir comp type typedir
+              echo 'node_modules/**'
+              for dir in "$extras"/*/; do
+                  [ -d "$dir" ] || continue
+                  comp="$(sed -n "/^[[:space:]]*\$plugin->component[[:space:]]*=/{s/^[^=]*=[[:space:]]*'\([a-z0-9_]*\)'.*/\1/p;q;}" \
+                      "${dir}version.php" 2>/dev/null)" || comp=""
+                  type="${comp%%_*}"
+                  typedir=""
+                  if [ -n "$comp" ] && [ "$type" != "$comp" ]; then
+                      typedir="$(awk -v t="$type" '
+                          /"plugintypes"[[:space:]]*:/ { inblock = 1; next }
+                          inblock && /}/ { exit }
+                          inblock && $0 ~ "^[[:space:]]*\"" t "\"[[:space:]]*:" {
+                              v = $0
+                              sub(/^[^:]*:[[:space:]]*"/, "", v)
+                              sub(/".*$/, "", v)
+                              gsub(/\\\//, "/", v)
+                              print v
+                              exit
+                          }' "$moodle/lib/components.json")"
+                  fi
+                  if [ -z "$typedir" ]; then
+                      echo "gherkinlint: cannot place the dependency ${dir%/} (component '$comp') in $moodle/lib/components.json" >&2
+                      return 1
+                  fi
+                  echo "$typedir/${comp#*_}/**"
+              done
+          }
+          MOODLE_DIR=$(grep '^MOODLE_DIR=' ci/.env 2>/dev/null | cut -d= -f2-) || true
+          EXTRA_PLUGINS_DIR=$(grep '^EXTRA_PLUGINS_DIR=' ci/.env 2>/dev/null | cut -d= -f2-) || true
+          if [ -n "$MOODLE_DIR" ] && [ -n "$EXTRA_PLUGINS_DIR" ] && [ -d "$EXTRA_PLUGINS_DIR" ]; then
+            if ! mah_gherkin_lintignore "$MOODLE_DIR" "$EXTRA_PLUGINS_DIR" > "$MOODLE_DIR/.gherkin-lintignore"; then
+              echo "::error::Could not list the plugin dependencies for gherkinlint to skip."
+              exit 1
+            fi
+            echo "gherkinlint skips the plugin dependencies' features, .gherkin-lintignore:"
+            sed 's/^/    /' "$MOODLE_DIR/.gherkin-lintignore"
+          fi
+          moodle-plugin-ci grunt --max-lint-warnings ${{ inputs.grunt-max-lint-warnings }}
 
       - name: Mark cancelled jobs as failed.
         if: ${{ cancelled() }}
